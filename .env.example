# ===== TELEGRAM =====
TELEGRAM_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
TELEGRAM_CHAT_ID=123456789

# ===== KEAMANAN =====
# Dipakai /api/cron?secret=... dan /api/webhook?secret=...
# Gunakan string acak panjang (minimal 24 karakter)
CRON_SECRET=ganti_dengan_string_acak_panjang

# URL deployment Vercel (tanpa trailing slash)
VERCEL_PROJECT_URL=https://nama-project.vercel.app

# ===== APIFY =====
# Actor yang dipakai ketiga slot (boleh sama)
APIFY_ACTOR_ID=clockworks~tiktok-hashtag-scraper
APIFY_TOKEN_1=apify_api_token_slot_1
APIFY_TOKEN_2=apify_api_token_slot_2
APIFY_TOKEN_3=apify_api_token_slot_3

# ===== UPSTASH REDIS (REST) =====
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

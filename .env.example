# ===== TELEGRAM =====
TELEGRAM_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
TELEGRAM_CHAT_ID=123456789

# ===== SCRAPER (Apify) =====
APIFY_TOKEN=apify_api_ganti_dengan_token_anda
# Actor ID (cek di Apify Store, format username~nama-actor)
APIFY_TIKTOK_ACTOR=clockworks~tiktok-hashtag-scraper
APIFY_INSTAGRAM_ACTOR=apify~instagram-hashtag-scraper
ENABLE_TIKTOK=true
ENABLE_INSTAGRAM=false
# Jumlah video terbaru per tagar yang diambil tiap siklus (makin besar = makin mahal)
RESULTS_PER_HASHTAG=3

# ===== KRITERIA "GACOR" =====
MAX_AGE_HOURS=6
MIN_VIEWS=50000
# Opsional: minimal views/jam (0 = nonaktif)
MIN_VIEWS_PER_HOUR=0

# ===== JADWAL =====
# Cron expression. */30 = tiap 30 menit, 0 * * * * = tiap 1 jam
CRON_SCHEDULE=*/30 * * * *
TZ=Asia/Makassar

# ===== TUNING =====
# Berapa tagar diproses paralel (free plan Apify: mulai dari 2)
CONCURRENCY=2
MAX_RETRIES=3
MAX_ALERTS_PER_CYCLE=20

# Opsional: override daftar tagar (pisahkan koma). Kosongkan untuk pakai config/hashtags.json
HASHTAGS=
